KURRENTDB_CLUSTER_SIZE=3
KURRENTDB_RUN_PROJECTIONS=All
KURRENTDB_NODE_PORT=2113
KURRENTDB_TRUSTED_ROOT_CERTIFICATES_PATH=/etc/eventstore/certs/ca
KURRENTDB_DISCOVER_VIA_DNS=false
KURRENTDB_ENABLE_ATOM_PUB_OVER_HTTP=true
KURRENTDB_LEADER_ELECTION_TIMEOUT_MS=10000
KURRENTDB_GOSSIP_TIMEOUT_MS=5000
KURRENTDB_ALLOW_UNKNOWN_OPTIONS=true
KURRENTDB_TELEMETRY_OPTOUT=true
EVENTSTORE_CLUSTER_SIZE=3
EVENTSTORE_RUN_PROJECTIONS=All
EVENTSTORE_NODE_PORT=2113
EVENTSTORE_TRUSTED_ROOT_CERTIFICATES_PATH=/etc/eventstore/certs/ca
EVENTSTORE_DISCOVER_VIA_DNS=false
EVENTSTORE_ENABLE_ATOM_PUB_OVER_HTTP=true
EVENTSTORE_LEADER_ELECTION_TIMEOUT_MS=10000
EVENTSTORE_GOSSIP_TIMEOUT_MS=5000
